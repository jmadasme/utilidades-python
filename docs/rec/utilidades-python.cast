[136.912, "o", "\u001b[90m┌─ console_utils.py · print_recognized() ───────────────────────────────────────────────────────────────\u001b[0m\n"]
[136.912, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mprint_recognized\u001b[39;49;00m(text: \u001b[96mstr\u001b[39;49;00m) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[136.967, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[137.022, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0m    Imprime texto reconocido con timestamp y color.\u001b[90m\u001b[39;49;00m\n"]
[137.077, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[137.132, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m    Formato: [HH:MM:SS] texto reconocido\u001b[90m\u001b[39;49;00m\n"]
[137.187, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m    El timestamp aparece en cian y el texto en blanco brillante.\u001b[90m\u001b[39;49;00m\n"]
[137.242, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[137.297, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m    Args:\u001b[90m\u001b[39;49;00m\n"]
[137.352, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m        text: Texto reconocido por el motor SAPI.\u001b[90m\u001b[39;49;00m\n"]
[137.407, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[137.462, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m    reset = Style.RESET_ALL \u001b[94mif\u001b[39;49;00m COLORAMA_DISPONIBLE \u001b[94melse\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[137.517, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m    bright = Style.BRIGHT \u001b[94mif\u001b[39;49;00m COLORAMA_DISPONIBLE \u001b[94melse\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[137.572, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m    print_timestamp(color=Fore.CYAN, stream=sys.stdout)\u001b[90m\u001b[39;49;00m\n"]
[137.627, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m    sys.stdout.write(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mbright\u001b[33m}\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mFore.WHITE\u001b[33m}\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtext\u001b[33m}\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mreset\u001b[33m}\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[137.682, "o", "\u001b[90m  79\u001b[0m\u001b[90m │ \u001b[0m    sys.stdout.flush()\u001b[90m\u001b[39;49;00m\n"]
