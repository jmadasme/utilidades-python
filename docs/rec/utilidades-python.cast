[150.544, "o", "\u001b[90m┌─ run.bat · lanzador para Windows ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[150.544, "o", "\u001b[90m   1\u001b[0m\u001b[90m │ \u001b[0m@\u001b[94mecho\u001b[39;49;00m off\n"]
[150.599, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mtitle\u001b[39;49;00m SpeechToTextAuxPy - Reconocimiento de Voz SAPI\n"]
[150.654, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0mchcp 65001 > nul\n"]
[150.709, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\n"]
[150.764, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mecho\u001b[39;49;00m === SpeechToTextAuxPy ===\n"]
[150.819, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mecho\u001b[39;49;00m.\n"]
[150.874, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mecho\u001b[39;49;00m Instalando dependencias...\n"]
[150.929, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0mpip install -r requirements.txt\n"]
[150.984, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mif\u001b[39;49;00m \u001b[91m%errorlevel%\u001b[39;49;00m \u001b[95mneq\u001b[39;49;00m 0 (\n"]
[151.039, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mecho\u001b[39;49;00m.\n"]
[151.094, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mecho\u001b[39;49;00m Error: No se pudieron instalar las dependencias.\n"]
[151.149, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mecho\u001b[39;49;00m Asegurate de tener Python 3.10+ y pip instalados.\n"]
[151.204, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mpause\u001b[39;49;00m\n"]
[151.259, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mexit\u001b[39;49;00m /b \u001b[91m%errorlevel%\u001b[39;49;00m\n"]
[151.314, "o", "\u001b[90m  15\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m)\u001b[39;49;00m\n"]
[151.369, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mecho\u001b[39;49;00m.\n"]
[151.424, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mecho\u001b[39;49;00m Iniciando reconocimiento de voz...\n"]
[151.479, "o", "\u001b[90m  18\u001b[0m\u001b[90m │ \u001b[0mpython src/main.py\n"]
[151.534, "o", "\u001b[90m└───────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[151.634, "o", "\n"]
[151.634, "o", "\u001b[92m  $ \u001b[0m\u001b[97m\u001b[1mpython versions/SpeechToTextAuxPy/src/main.py\u001b[0m\n"]
