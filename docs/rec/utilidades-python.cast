[27.584, "o", "\u001b[90m┌─ main.py · main() ────────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[27.584, "o", "\u001b[90m  94\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[27.639, "o", "\u001b[90m  95\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Crear instancia del motor SAPI con idioma español\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[27.694, "o", "\u001b[90m  96\u001b[0m\u001b[90m │ \u001b[0m        _engine = SapiEngine(language=\u001b[33m\"\u001b[39;49;00m\u001b[33mes-ES\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[27.749, "o", "\u001b[90m  97\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[27.804, "o", "\u001b[90m  98\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Iniciar reconocimiento\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[27.859, "o", "\u001b[90m  99\u001b[0m\u001b[90m │ \u001b[0m        _engine.start()\u001b[90m\u001b[39;49;00m\n"]
[27.914, "o", "\u001b[90m 100\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[27.969, "o", "\u001b[90m 101\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Mantener el programa vivo esperando señales\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.024, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# signal.pause() no está disponible en Windows,\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.079, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# así que usamos un bucle simple con espera\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.134, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m        console_utils.print_info(\u001b[33m\"\u001b[39;49;00m\u001b[33mEsperando entrada de voz...\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[28.189, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mwhile\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.244, "o", "\u001b[90m 106\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.299, "o", "\u001b[90m 107\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# Esperar indefinidamente hasta Ctrl+C\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.354, "o", "\u001b[90m 108\u001b[0m\u001b[90m │ \u001b[0m                signal.pause()\u001b[90m\u001b[39;49;00m\n"]
[28.409, "o", "\u001b[90m 109\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m \u001b[96mAttributeError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.464, "o", "\u001b[90m 110\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# signal.pause() no está en Windows, usamos bucle con sleep\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.519, "o", "\u001b[90m 111\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mimport\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96mtime\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.574, "o", "\u001b[90m 112\u001b[0m\u001b[90m │ \u001b[0m                time.sleep(\u001b[94m0.5\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
